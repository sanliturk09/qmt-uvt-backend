DB_SERVER=your_server_ip
DB_NAME=UVT_DB
DB_USER=your_db_user
DB_PASS=your_db_password
# SAP B1 company databases are queried read-only for LZR batch availability.
SAP_TR_DB_NAME=QMT_TR_TEST
SAP_DE_DB_NAME=your_de_sap_company_database
# SAP B1 sheet stock is in m²; one standard sheet is 4.5 m².
LZR_SHEET_AREA_M2=4.5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET_KEY=generate_a_random_secret_with_at_least_32_characters
